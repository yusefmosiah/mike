# Root env for Docker Compose. Browser auth is handled by the backend and no
# auth key or API origin is baked into the frontend bundle.

# The browser-reachable URL of the GoTrue auth service: confirmation links,
# password resets and OAuth callbacks point here.
AUTH_PUBLIC_URL=http://localhost:54321
API_BASE_URL=http://backend:3001
# Local Compose uses HTTP. Set NODE_ENV=production only with HTTPS public URLs.
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3000/api
GOTRUE_MAILER_AUTOCONFIRM=true

# Google OAuth for the Docker Compose Auth service. The Google client must
# allow http://localhost:54321/callback (AUTH_PUBLIC_URL + /callback). Set this
# to false to opt out locally.
GOTRUE_EXTERNAL_GOOGLE_ENABLED=true
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=
GOTRUE_EXTERNAL_GOOGLE_SECRET=

# Set both values for a deployed Word add-in. Generate a dedicated handoff key
# with `openssl rand -hex 32`; do not reuse an auth or signing secret.
WORD_ADDIN_URL=
AUTH_HANDOFF_ENCRYPTION_SECRET=

# Error reporting is ON BY DEFAULT and goes to the Mike project's own Sentry
# (see README "Telemetry" and docs/observability.md): never document text,
# bodies, cookies, auth headers or emails, and on a community install no
# machine name, user id, headers, breadcrumbs or file paths either. Opt out
# with SENTRY_DISABLED=true (applies to the backend, the web build, and the
# Next server through compose). To use your own Sentry, set SENTRY_DSN
# (backend) and FRONTEND_SENTRY_DSN (web app; baked into the browser bundle at
# image build time and given to the Next server at runtime).
SENTRY_DISABLED=false
SENTRY_DSN=
FRONTEND_SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
