// Type-checks the replay simulator, which runs with Node's type stripping
// (`node scripts/replay/cli.mts`) and is outside the server build:
//   npx tsc -p scripts/replay
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@mike/contracts": ["../../../packages/contracts/index.d.ts"]
    }
  },
  "include": ["./*.mts"]
}
