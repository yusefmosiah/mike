{
    "name": "mike-mobile",
    "version": "0.1.0",
    "private": true,
    "description": "Mike for iPhone and Android: a Capacitor shell around the hosted Mike web app.",
    "license": "AGPL-3.0-only",
    "scripts": {
        "www": "node scripts/write-www.mjs",
        "sync": "npm run www && cap sync",
        "ios:configure": "node scripts/configure-ios.mjs",
        "ios:add": "npm run www && cap add ios && npm run ios:configure",
        "build:ios": "cap build ios",
        "build:android": "cap build android"
    },
    "dependencies": {
        "@capacitor/app": "^8.1.2",
        "@capacitor/camera": "^8.2.5",
        "@capacitor/core": "^8.5.2",
        "@capacitor/ios": "^8.5.3",
        "@capacitor/preferences": "^8.0.1",
        "@mike/speech": "file:plugins/speech"
    },
    "devDependencies": {
        "@capacitor/cli": "^8.5.2"
    },
    "type": "module"
}
